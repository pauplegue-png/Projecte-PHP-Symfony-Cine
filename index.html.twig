<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cartelera</title>
    <link rel="stylesheet" href="css/colors.css" />
    <link rel="stylesheet" href="fonts/typography.css" />
    <link rel="stylesheet" href="fonts/sizes.css" />
    <link rel="stylesheet" href="css/global.css" />
    <link rel="stylesheet" href="css/headers.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="js/tailwind-config.js"></script>
  </head>
  <body class="bg-blancoroto font-body text-grisoscuro min-h-screen flex flex-col">
    <header class="header-cartelera relative overflow-hidden" aria-label="Navegación principal">
      <img src="img/cabecera-cartelera.png" alt="" class="header-img absolute inset-0 w-full h-full object-cover" />
      <div class="relative z-10 flex items-center justify-end gap-3 px-4 sm:px-8 pt-4 text-blanco">
        <a href="perfilUsuari.html" aria-label="Abrir perfil" class="inline-flex"><span class="grid place-items-center w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-rojooscuro text-blanco border border-grisclaro">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            </span></a>
        <a href="Login.html" aria-label="Cerrar sesión" class="inline-flex text-blanco hover:opacity-80"><svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg></a>
      </div>
    </header>
    <main class="flex-1 mx-auto w-full max-w-[1200px] px-4 sm:px-8 py-10">
      <h1 class="font-heading font-bold text-display text-center">Cartelera</h1>
      <section aria-label="Películas disponibles" class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12">
          <article class="flex flex-col items-center text-center gap-3">
            <div class="relative aspect-[2/3] overflow-hidden rounded-sm bg-gradient-to-br from-grismediooscuro to-grisoscuro shadow-lg w-full max-w-[270px]">
              <span class="absolute inset-0 grid place-items-center p-3 text-center text-blanco font-heading font-bold">Horizonte roto</span>
              <img src="./img/carteleraImgHorizonteRoto.png" alt="Póster de Horizonte roto" class="relative w-full h-full object-cover" onerror="this.remove()" />
            </div>
            <h2 class="font-body font-semibold text-heading tracking-tight">Horizonte roto</h2>
            <div class="flex items-center gap-5">
              <p class="font-body font-bold text-subheading">+ 12</p>
              <a href="sinopsis.html" aria-label="Ver sinopsis de Horizonte roto" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-rojooscuro hover:bg-rojohover text-blanco text-small font-medium transition"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 7l1.5 3 3.3.5-2.4 2.3.6 3.3-3-1.6-3 1.6.6-3.3-2.4-2.3 3.3-.5z"/></svg>Sinopsis</a>
            </div>
          </article>
          <article class="flex flex-col items-center text-center gap-3">
            <div class="relative aspect-[2/3] overflow-hidden rounded-sm bg-gradient-to-br from-grismediooscuro to-grisoscuro shadow-lg w-full max-w-[270px]">
              <span class="absolute inset-0 grid place-items-center p-3 text-center text-blanco font-heading font-bold">Operacion medianoche</span>
              <img src="img/image-2.png" alt="Póster de Operacion medianoche" class="relative w-full h-full object-cover" onerror="this.remove()" />
            </div>
            <h2 class="font-body font-semibold text-heading tracking-tight">Operacion medianoche</h2>
            <div class="flex items-center gap-5">
              <p class="font-body font-bold text-subheading">+ 12</p>
              <a href="sinopsis.html" aria-label="Ver sinopsis de Operacion medianoche" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-rojooscuro hover:bg-rojohover text-blanco text-small font-medium transition"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 7l1.5 3 3.3.5-2.4 2.3.6 3.3-3-1.6-3 1.6.6-3.3-2.4-2.3 3.3-.5z"/></svg>Sinopsis</a>
            </div>
          </article>
          <article class="flex flex-col items-center text-center gap-3">
            <div class="relative aspect-[2/3] overflow-hidden rounded-sm bg-gradient-to-br from-grismediooscuro to-grisoscuro shadow-lg w-full max-w-[270px]">
              <span class="absolute inset-0 grid place-items-center p-3 text-center text-blanco font-heading font-bold">Tierra de nadie</span>
              <img src="img/image-3.png" alt="Póster de Tierra de nadie" class="relative w-full h-full object-cover" onerror="this.remove()" />
            </div>
            <h2 class="font-body font-semibold text-heading tracking-tight">Tierra de nadie</h2>
            <div class="flex items-center gap-5">
              <p class="font-body font-bold text-subheading">+ 12</p>
              <a href="sinopsis.html" aria-label="Ver sinopsis de Tierra de nadie" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-rojooscuro hover:bg-rojohover text-blanco text-small font-medium transition"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 7l1.5 3 3.3.5-2.4 2.3.6 3.3-3-1.6-3 1.6.6-3.3-2.4-2.3 3.3-.5z"/></svg>Sinopsis</a>
            </div>
          </article>
          <article class="flex flex-col items-center text-center gap-3">
            <div class="relative aspect-[2/3] overflow-hidden rounded-sm bg-gradient-to-br from-grismediooscuro to-grisoscuro shadow-lg w-full max-w-[270px]">
              <span class="absolute inset-0 grid place-items-center p-3 text-center text-blanco font-heading font-bold">Una noche sin luna</span>
              <img src="img/image-4.png" alt="Póster de Una noche sin luna" class="relative w-full h-full object-cover" onerror="this.remove()" />
            </div>
            <h2 class="font-body font-semibold text-heading tracking-tight">Una noche sin luna</h2>
            <div class="flex items-center gap-5">
              <p class="font-body font-bold text-subheading">+ 12</p>
              <a href="sinopsis.html" aria-label="Ver sinopsis de Una noche sin luna" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-rojooscuro hover:bg-rojohover text-blanco text-small font-medium transition"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 7l1.5 3 3.3.5-2.4 2.3.6 3.3-3-1.6-3 1.6.6-3.3-2.4-2.3 3.3-.5z"/></svg>Sinopsis</a>
            </div>
          </article>
      </section>
    </main>
    <footer class="bg-rojosuave text-blanco font-subheading text-small sm:text-subheading px-6 sm:px-[72px] py-4 mt-auto">
      Todos los derechos reservados
    </footer>
  </body>
</html>
