<!doctype html>
<html lang="es">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="utf-8" />
    <meta
      name="description"
      content="Selecciona una fecha y horario para ver Hasta el horizonte"
    />
    <link rel="stylesheet" href="css/colors.css" />
    <link rel="stylesheet" href="fonts/typography.css" />
    <link rel="stylesheet" href="fonts/sizes.css" />
    <link rel="stylesheet" href="css/global.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="js/tailwind-config.js"></script>
  </head>
  <body>
    <div
      class="bg-[#f5f2f0] overflow-hidden border border-solid border-black w-full min-w-[1440px] min-h-[1041px] relative"
    >
      <header
        class="absolute top-0 left-[-3px] w-[1450px] h-[232px] bg-transparent"
        aria-label="Información de la película"
      >
        <div
          class="flex flex-col w-[1440px] h-[232px] items-center justify-center pl-[117px] pr-0.5 py-0 absolute top-0 left-0 bg-color-scheme-grays-black overflow-hidden opacity-[0.88]"
        >
          <img
            class="relative w-[1563px] h-[232px] mt-[-329.00px] ml-[-121.00px] mr-[-121.00px] z-[1]"
            src="img/rectangle-1.png"
            alt=""
          />
          <img
            class="relative w-[1437px] h-[232px] ml-[-114.00px] mr-[-2.00px] z-0 aspect-[2.38] object-cover"
            src="img/img.png"
            alt="Escena de la película Hasta el horizonte"
          />
        </div>
        <div
          class="absolute top-[147px] left-[517px] w-[142px] h-14 flex items-center justify-center [font-family:'Lato-Regular',Helvetica] font-normal text-[#d14d06] text-2xl text-center tracking-[0] leading-[normal]"
        >
          M-12
        </div>
        <h1
          class="absolute top-[82px] left-[484px] w-[490px] h-[75px] flex items-center justify-center [font-family:'Nunito-Regular',Helvetica] font-normal text-white text-[32px] text-center tracking-[0] leading-[normal]"
        >
          Hasta el horizonte
        </h1>
        <p
          class="absolute top-[158px] left-[729px] w-[201px] h-[35px] flex items-center justify-center [font-family:'Lato-Regular',Helvetica] font-normal text-white text-2xl text-center tracking-[0] leading-[normal]"
        >
          Acción, Drama
        </p>
        <p
          class="absolute top-[149px] left-[616px] w-[119px] h-[52px] flex items-center justify-center [font-family:'Lato-Regular',Helvetica] font-normal text-white text-2xl text-center tracking-[0] leading-[normal]"
        >
          159 min
        </p>
        <span
          class="top-[150px] left-[675px] w-[119px] h-[52px] flex items-center justify-center [font-family:'Inter-Regular',Helvetica] font-normal text-white text-2xl leading-[normal] absolute text-center tracking-[0]"
          aria-hidden="true"
          >|</span
        >
        <nav aria-label="Navegación principal">
          <button
            type="button"
            class="absolute top-[26px] left-[1355px] w-[46px] h-[53px] flex bg-transparent border-0 p-0"
            aria-label="Cerrar sesión"
          >
            <img class="flex-1 w-[38.5px]" src="img/icon.svg" alt="" />
          </button>
          <button
            type="button"
            class="absolute top-[29px] left-[94px] w-[45px] h-[47px] flex bg-transparent border-0 p-0"
            aria-label="Volver"
          >
            <img class="flex-1 w-[30px]" src="img/icon-2.svg" alt="" />
          </button>
          <button
            type="button"
            class="absolute top-[31px] left-[34px] w-[43px] h-[43px] bg-transparent border-0 p-0"
            aria-label="Ir al inicio"
          >
            <img class="w-[43px] h-[43px]" src="img/home.svg" alt="" />
          </button>
          <button
            type="button"
            class="absolute top-[23px] left-[1273px] w-[61px] h-[58px] flex bg-[#a9474f] rounded-[100px] overflow-hidden border border-solid border-[#a6a6a6]"
            aria-label="Abrir perfil"
          >
            <img
              class="flex-1 w-[42.98px]"
              src="img/avatar-placeholder.svg"
              alt=""
            />
          </button>
        </nav>
      </header>
      <main>
        <section
          class="flex flex-col w-[1335px] h-[174px] items-start gap-5 p-6 absolute top-[297px] left-[43px] bg-white rounded-[20px] overflow-hidden border border-solid border-[#303238]"
          aria-labelledby="date-heading"
        >
          <div
            class="flex items-center justify-between relative self-stretch w-full flex-[0_0_auto]"
          >
            <h2
              id="date-heading"
              class="relative w-fit mt-[-1.00px] [font-family:'Inter-SemiBold',Helvetica] font-semibold text-[#555555] text-lg tracking-[0] leading-6 whitespace-nowrap"
            >
              Elije el Dia
            </h2>
            <p
              class="relative w-fit [font-family:'Inter-Regular',Helvetica] font-normal text-[#555555] text-[13px] tracking-[0] leading-5 whitespace-nowrap"
            >
              4 sesiones
            </p>
          </div>
          <nav
            class="flex items-center gap-3 relative self-stretch w-full flex-[0_0_auto]"
            aria-label="Seleccionar fecha"
          >
            <button
              type="button"
              class="flex w-10 h-10 items-center justify-center relative bg-[#a9474f] rounded-3xl overflow-hidden border border-solid border-[#303238]"
              aria-label="Día anterior"
            >
              <img
                class="relative w-[22.83px] h-[21.75px]"
                src="img/image.svg"
                alt=""
              />
            </button>
            <button
              type="button"
              class="date-option bg-white border-black flex h-[72px] items-center justify-center relative flex-1 grow rounded-xl overflow-hidden border border-solid appearance-none"
              aria-pressed="false"
            >
              <span
                class="relative w-fit [font-family:'Inter-Medium',Helvetica] font-medium text-[#1f1f1f] text-2xl tracking-[-0.12px] leading-8 whitespace-nowrap"
                >28 OCT</span
              >
            </button>
            <button
              type="button"
              class="date-option bg-[#a9474f] border-[#010101] flex h-[72px] items-center justify-center relative flex-1 grow rounded-xl overflow-hidden border border-solid appearance-none"
              aria-pressed="true"
            >
              <span
                class="relative w-fit [font-family:'Inter-Medium',Helvetica] font-medium text-[#f3f3f4] text-2xl tracking-[-0.12px] leading-8 whitespace-nowrap"
                >29 OCT</span
              >
            </button>
            <button
              type="button"
              class="date-option bg-white border-black flex h-[72px] items-center justify-center relative flex-1 grow rounded-xl overflow-hidden border border-solid appearance-none"
              aria-pressed="false"
            >
              <span
                class="relative w-fit [font-family:'Inter-Medium',Helvetica] font-medium text-[#1f1f1f] text-2xl tracking-[-0.12px] leading-8 whitespace-nowrap"
                >30 OCT</span
              >
            </button>
            <button
              type="button"
              class="date-option bg-white border-black flex h-[72px] items-center justify-center relative flex-1 grow rounded-xl overflow-hidden border border-solid appearance-none"
              aria-pressed="false"
            >
              <span
                class="relative w-fit [font-family:'Inter-Medium',Helvetica] font-medium text-[#1f1f1f] text-2xl tracking-[-0.12px] leading-8 whitespace-nowrap"
                >01 NOV</span
              >
            </button>
            <button
              type="button"
              class="flex w-10 h-10 items-center justify-center relative bg-[#a9474f] rounded-3xl overflow-hidden border border-solid border-[#303238]"
              aria-label="Día siguiente"
            >
              <img
                class="relative w-[22.83px] h-[21.75px]"
                src="img/flecha.svg"
                alt=""
              />
            </button>
          </nav>
        </section>
        <section
          class="absolute top-[525px] left-[136px] w-[1177px] h-[474px]"
          aria-labelledby="schedule-heading"
        >
          <h2
            id="schedule-heading"
            class="absolute top-0 left-[376px] w-[409px] h-[59px] flex items-center justify-center [font-family:'Nunito-SemiBold',Helvetica] font-semibold text-black text-5xl text-center tracking-[0] leading-6"
          >
            Horarios
          </h2>
          <div role="group" aria-label="Horarios disponibles">
            <button
              type="button"
              class="time-option top-[121px] left-0 absolute w-[255px] h-[159px] shadow-[0px_4px_4px_#00000040] appearance-none bg-transparent border-0 p-0"
              aria-pressed="false"
            >
              <span
                class="absolute top-0 left-0 w-[251px] h-[159px] bg-[#a6a6a6] rounded-[30px] border border-solid"
              ></span>
              <span
                class="absolute top-[17px] left-[68px] w-[114px] h-[52px] flex items-center justify-center [-webkit-text-stroke:1px_#000000] [font-family:'Lato-ExtraLight',Helvetica] font-extralight text-black text-2xl text-center tracking-[0] leading-6"
                >3D</span
              >
              <span
                class="top-[52px] left-[60px] w-[130px] h-[86px] flex items-center justify-center [-webkit-text-stroke:1px_#000000] [font-family:'Lato-ExtraLight',Helvetica] font-extralight text-[#1f1f1f] text-[40px] leading-6 absolute text-center tracking-[0]"
                >09:00</span
              >
            </button>
            <button
              type="button"
              class="time-option top-[121px] left-[299px] absolute w-[255px] h-[159px] shadow-[0px_4px_4px_#00000040] appearance-none bg-transparent border-0 p-0"
              aria-pressed="false"
            >
              <span
                class="absolute top-0 left-0 w-[251px] h-[159px] bg-[#a6a6a6] rounded-[30px] border border-solid"
              ></span>
              <span
                class="top-4 [font-family:'Lato-ExtraLight',Helvetica] font-extralight absolute left-[68px] w-[114px] h-[52px] flex items-center justify-center [-webkit-text-stroke:1px_#000000] text-black text-2xl text-center tracking-[0] leading-6"
                >2D</span
              >
              <span
                class="top-[51px] left-[60px] w-[130px] h-[86px] flex items-center justify-center [-webkit-text-stroke:1px_#000000] [font-family:'Lato-ExtraLight',Helvetica] font-extralight text-[#1f1f1f] text-[40px] leading-6 absolute text-center tracking-[0]"
                >10:00</span
              >
            </button>
            <button
              type="button"
              class="time-option top-[121px] left-[616px] absolute w-[255px] h-[159px] shadow-[0px_4px_4px_#00000040] appearance-none bg-transparent border-0 p-0"
              aria-pressed="false"
            >
              <span
                class="absolute top-0 left-0 w-[251px] h-[159px] bg-[#a6a6a6] rounded-[30px] border border-solid"
              ></span>
              <span
                class="absolute top-[13px] left-[68px] w-[114px] h-[52px] flex items-center justify-center [-webkit-text-stroke:1px_#000000] [font-family:'Lato-ExtraLight',Helvetica] font-extralight text-black text-2xl text-center tracking-[0] leading-6"
                >2D</span
              >
              <span
                class="top-12 left-[60px] w-[130px] h-[86px] flex items-center justify-center [-webkit-text-stroke:1px_#000000] [font-family:'Lato-ExtraLight',Helvetica] font-extralight text-black text-[40px] leading-6 absolute text-center tracking-[0]"
                >14:00</span
              >
            </button>
            <button
              type="button"
              class="time-option top-[121px] left-[924px] absolute w-[255px] h-[159px] shadow-[0px_4px_4px_#00000040] appearance-none bg-transparent border-0 p-0"
              aria-pressed="false"
            >
              <span
                class="absolute top-0 left-0 w-[251px] h-[159px] bg-[#a6a6a6] rounded-[30px] border border-solid"
              ></span>
              <span
                class="absolute top-[13px] left-[68px] w-[114px] h-[52px] flex items-center justify-center [-webkit-text-stroke:1px_#000000] [font-family:'Lato-ExtraLight',Helvetica] font-extralight text-black text-2xl text-center tracking-[0] leading-6"
                >2D</span
              >
              <span
                class="absolute top-12 left-[60px] w-[130px] h-[86px] flex items-center justify-center [-webkit-text-stroke:1px_#000000] [font-family:'Lato-ExtraLight',Helvetica] font-extralight text-[#1f1f1f] text-[40px] text-center tracking-[0] leading-6"
                >15:00</span
              >
            </button>
            <button
              type="button"
              class="time-option top-[315px] left-0 absolute w-[255px] h-[159px] shadow-[0px_4px_4px_#00000040] appearance-none bg-transparent border-0 p-0"
              aria-pressed="true"
            >
              <span
                class="absolute top-0 left-0 w-[251px] h-[159px] bg-[#a9474f] rounded-[30px] border border-solid border-black"
              ></span>
              <span
                class="top-[13px] [font-family:'Lato-Light',Helvetica] font-light absolute left-[68px] w-[114px] h-[52px] flex items-center justify-center [-webkit-text-stroke:1px_#000000] text-black text-2xl text-center tracking-[0] leading-6"
                >2D</span
              >
              <span
                class="top-[79px] left-[60px] w-[130px] h-6 flex items-center justify-center [-webkit-text-stroke:1px_#000000] [font-family:'Lato-Light',Helvetica] font-light text-[#1f1f1f] text-[40px] leading-6 absolute text-center tracking-[0]"
                >16:00</span
              >
            </button>
            <button
              type="button"
              class="time-option top-[315px] left-[308px] absolute w-[255px] h-[159px] shadow-[0px_4px_4px_#00000040] appearance-none bg-transparent border-0 p-0"
              aria-pressed="false"
            >
              <span
                class="absolute top-0 left-0 w-[251px] h-[159px] bg-[#a6a6a6] rounded-[30px] border border-solid"
              ></span>
              <span
                class="absolute top-[13px] left-[68px] w-[114px] h-[52px] flex items-center justify-center [-webkit-text-stroke:1px_#000000] [font-family:'Lato-ExtraLight',Helvetica] font-extralight text-black text-2xl text-center tracking-[0] leading-6"
                >2D</span
              >
              <span
                class="absolute top-12 left-[60px] w-[130px] h-[86px] flex items-center justify-center [-webkit-text-stroke:1px_#000000] [font-family:'Lato-ExtraLight',Helvetica] font-extralight text-[#1f1f1f] text-[40px] text-center tracking-[0] leading-6"
                >20:00</span
              >
            </button>
            <button
              type="button"
              class="time-option top-[315px] left-[616px] absolute w-[255px] h-[159px] shadow-[0px_4px_4px_#00000040] appearance-none bg-transparent border-0 p-0"
              aria-pressed="false"
            >
              <span
                class="absolute top-0 left-0 w-[251px] h-[159px] bg-[#a6a6a6] rounded-[30px] border border-solid"
              ></span>
              <span
                class="absolute top-[13px] left-[68px] w-[114px] h-[52px] flex items-center justify-center [-webkit-text-stroke:1px_#000000] [font-family:'Lato-ExtraLight',Helvetica] font-extralight text-black text-2xl text-center tracking-[0] leading-6"
                >2D</span
              >
              <span
                class="absolute top-12 left-[60px] w-[130px] h-[86px] flex items-center justify-center [-webkit-text-stroke:1px_#000000] [font-family:'Lato-ExtraLight',Helvetica] font-extralight text-[#1f1f1f] text-[40px] text-center tracking-[0] leading-6"
                >22:00</span
              >
            </button>
            <button
              type="button"
              class="time-option top-[315px] left-[924px] absolute w-[255px] h-[159px] shadow-[0px_4px_4px_#00000040] appearance-none bg-transparent border-0 p-0"
              aria-pressed="false"
            >
              <span
                class="absolute top-0 left-0 w-[251px] h-[159px] bg-[#a6a6a6] rounded-[30px] border border-solid"
              ></span>
              <span
                class="absolute top-[13px] left-[68px] w-[114px] h-[52px] flex items-center justify-center [-webkit-text-stroke:1px_#000000] [font-family:'Lato-ExtraLight',Helvetica] font-extralight text-black text-2xl text-center tracking-[0] leading-6"
                >2D</span
              >
              <span
                class="top-12 left-[60px] w-[130px] h-[86px] [-webkit-text-stroke:1px_#000000] [font-family:'Lato-ExtraLight',Helvetica] font-extralight text-transparent text-[40px] leading-6 absolute text-center tracking-[0]"
              >
                <span class="text-black">23:</span
                ><span class="text-[#1f1f1f]">00</span>
              </span>
            </button>
          </div>
        </section>
        <div
          class="flex flex-col w-[1328px] h-[23px] items-start justify-center absolute top-[589px] left-[67px]"
          role="separator"
          aria-hidden="true"
        >
          <img
            class="relative self-stretch w-full h-px object-cover"
            src="img/divider.svg"
            alt=""
          />
        </div>
      </main>
    </div>
