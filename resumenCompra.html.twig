<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Resumen de compra</title>
    <link rel="stylesheet" href="css/colors.css" />
    <link rel="stylesheet" href="fonts/typography.css" />
    <link rel="stylesheet" href="fonts/sizes.css" />
    <link rel="stylesheet" href="css/global.css" />
    <link rel="stylesheet" href="css/headers.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="js/tailwind-config.js"></script>
  </head>
  <body class="bg-blancoroto font-body text-grisoscuro min-h-screen flex flex-col">
    <header class="header-pelicula relative overflow-hidden text-blanco" aria-label="Información de la película">
        <img src="img/cabecera-pelicula.png" alt="" class="header-img absolute inset-0 w-full h-full object-cover" />
        <div class="relative z-10">
        <div class="flex items-center justify-between gap-4 px-4 sm:px-8 pt-4">
          <nav aria-label="Navegación principal" class="flex items-center gap-3">
            <a href="index.html" aria-label="Ir al inicio" class="inline-flex text-blanco hover:opacity-80 transition"><svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg></a>
            <a href="selecioSeients.html" aria-label="Volver" class="inline-flex text-blanco hover:opacity-80 transition"><svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg></a>
          </nav>
          <nav aria-label="Cuenta de usuario" class="flex items-center gap-3">
            <a href="perfilUsuari.html" aria-label="Perfil de usuario" class="inline-flex"><span class="grid place-items-center w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-rojooscuro text-blanco border border-grisclaro">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            </span></a>
            <a href="Login.html" aria-label="Cerrar sesión" class="inline-flex text-blanco hover:opacity-80 transition"><svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg></a>
          </nav>
        </div>
        <div class="px-4 pt-6 pb-8 sm:pb-10 text-center">
          <h1 class="font-ui text-subheading font-medium">Hasta el horizonte</h1>
          <p class="mt-1 flex flex-wrap justify-center items-center gap-2 text-small">
            <span class="text-amarillo font-semibold">M-12</span><span>159 min</span><span aria-hidden="true">|</span><span>Acción, Drama</span>
          </p>
        </div>
        </div>
      </header>
    <main class="flex-1 mx-auto w-full max-w-[860px] px-4 sm:px-8 py-8 grid gap-5">
      <section aria-label="Película" class="rounded-xl border border-grisoscuro/70 bg-blanco p-4 sm:p-6 flex gap-5 items-start">
        <div class="relative aspect-[2/3] overflow-hidden rounded-sm bg-gradient-to-br from-grismediooscuro to-grisoscuro shadow-lg w-24 sm:w-32 shrink-0">
              <span class="absolute inset-0 grid place-items-center p-3 text-center text-blanco font-heading font-bold">Hasta el horizonte</span>
              <img src="img/carteleraImgHorizonteRoto.png" alt="Póster de Hasta el horizonte" class="relative w-full h-full object-cover" onerror="this.remove()" />
            </div>
        <div>
          <h2 class="font-heading font-semibold text-heading">Hasta el horizonte</h2>
          <p class="mt-1 text-small"><span class="text-amarillo font-semibold">M-12</span> | 159 min | Acció, Drama</p>
          <p class="mt-4 text-small">Horario: Viernes, 24 Mayo, 20:00</p>
          <p class="text-small">Sala: Sala 2</p>
        </div>
      </section>
      <section aria-labelledby="seats-h" class="rounded-xl border border-grisoscuro/70 bg-blanco p-4 sm:p-6">
        <h2 id="seats-h" class="text-subheading">Asientos Selecionados</h2>
        <ul class="mt-3 flex gap-3"><li class="px-2 py-1 rounded bg-error text-blanco text-caption">A5</li><li class="px-2 py-1 rounded bg-error text-blanco text-caption">A6</li><li class="px-2 py-1 rounded bg-error text-blanco text-caption">A7</li></ul>
      </section>
      <section aria-labelledby="price-h" class="rounded-xl border border-grisoscuro/70 bg-blanco p-4 sm:p-6">
        <h2 id="price-h" class="text-subheading">Resumen del Precio</h2>
        <dl class="mt-3 text-small">
          <div class="flex items-center gap-3 py-1"><dt>Entradas (3): 30.00€</dt><dd class="flex-1 border-t border-grisoscuro" aria-hidden="true"></dd></div>
          <div class="flex items-center gap-3 py-1"><dt>Sericio de gestión: 3.00€</dt><dd class="flex-1 border-t border-grisoscuro" aria-hidden="true"></dd></div>
        </dl>
        <p class="mt-3 pt-3 border-t border-grisoscuro text-subheading">Preu Final: <strong class="font-semibold">33.00€</strong></p>
      </section>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="index.html" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-error hover:opacity-90 text-blanco text-small font-medium transition"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 7l1.5 3 3.3.5-2.4 2.3.6 3.3-3-1.6-3 1.6.6-3.3-2.4-2.3 3.3-.5z"/></svg>Cancelar Compra</a>
        <a href="Pagament.html" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-exito hover:opacity-90 text-blanco text-small font-medium transition"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 7l1.5 3 3.3.5-2.4 2.3.6 3.3-3-1.6-3 1.6.6-3.3-2.4-2.3 3.3-.5z"/></svg>Confirmar Compra</a>
      </div>
    </main>
    <footer class="bg-rojosuave text-blanco font-subheading text-small sm:text-subheading px-6 sm:px-[72px] py-4 mt-auto">
      Todos los derechos reservados
    </footer>
  </body>
</html>
